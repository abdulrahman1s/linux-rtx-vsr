{
  "manifest_version": 3,
  "name": "Linux RTX VSR",
  "version": "0.2.0",
  "minimum_chrome_version": "140",
  "description": "Local NVIDIA VideoSuperRes with per-site rules and synchronized playback.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Linux RTX VSR \u2014 ready",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["bridge.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  }
}
