{
  "name": "linux-rtx-vsr",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-extension.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "check": "bun run typecheck && bun scripts/sync-bun-deps.ts --check && bun scripts/check-extension.ts",
    "test": "bun test ./tests/*.test.ts",
    "test:browser": "bun run build && bun tests/browser.ts",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check ."
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/chrome": "0.3.6",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.13"
}
